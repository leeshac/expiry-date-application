{
  "openapi": "3.0.3",
  "info": {
    "title": "Expiry Date App API",
    "description": "API for taking photos of items, extracting expiry dates, and storing them per user.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/signup": {
      "post": {
        "summary": "Create a new user account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/signup_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_201"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Log in an existing user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/login_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "summary": "Get all items for the user",
        "responses": {
          "200": {
            "description": "List of items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/inline_response_200_1"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Add a new item (runs model + OCR)",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/items_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_201_1"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/predict-expiry": {
      "post": {
        "summary": "Predict expiry date from a photo",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/predictexpiry_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returns predicted expiry date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_2"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "items_body": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "login_body": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "aleesha"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "inline_response_201": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "image_url": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "inline_response_201_1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "inline_response_200_2": {
        "type": "object",
        "properties": {
          "expiry_date": {
            "type": "string",
            "example": "01/07/2026"
          }
        }
      },
      "predictexpiry_body": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "signup_body": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "aleesha"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}